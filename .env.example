# Copy this file to .env.local and fill in values

# Formspree endpoint ID (for early-access signup)
# Create a form at https://formspree.io — copy the ID from the endpoint URL
FORMSPREE_ID=xjxxxxxx

# OpenAI API key (for бот-коуч)
# Get it at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Plausible analytics domain (what you configure at plausible.io)
# Example: thinking.matsuka.online
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=thinking.matsuka.online
