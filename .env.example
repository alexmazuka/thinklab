# Env vars for ThinkLab — copy to .env.local for local dev, set in Vercel dashboard for prod.

# Bot coach — OpenRouter (proxy to many LLMs, OpenAI-compatible API).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override default model. See https://openrouter.ai/models
# Default is openai/gpt-4o-mini (cheap, good).
OPENROUTER_MODEL=openai/gpt-4o-mini

# Email signup via Formspree — create a form at https://formspree.io and put its ID here.
FORMSPREE_ID=xjgjynje

# For the client-side EmailForm (direct POST to Formspree without going through /api/subscribe).
# Same value as FORMSPREE_ID but exposed to client.
NEXT_PUBLIC_FORMSPREE_ID=xjgjynje

# Plausible analytics domain (what you configure at plausible.io)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=thinking.matsuka.online
